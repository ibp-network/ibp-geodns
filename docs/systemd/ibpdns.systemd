[Unit]
Description=IBP GeoDNS

[Service]
ExecStart=/opt/geodns/bin/IBPDns -config /etc/ibpdns/ibpdns.json
WorkingDirectory=/opt/geodns
User=ibp
Group=ibp
Restart=always
RestartSec=5
Environment=PATH=/usr/bin:/usr/local/bin:/usr/sbin:/usr/local/sbin:/usr/local/go/bin/

[Install]
WantedBy=multi-user.target