[Unit]
Description=IBP Mgmt & Stats API
After=ibp-geodns.service

[Service]
ExecStart=/opt/ibp-geodns/bin/mgmt-api
WorkingDirectory=/opt/ibp-geodns
User=ibp-geodns
Group=ibp-geodns
Restart=always
RestartSec=5
Environment=PATH=/usr/bin:/usr/local/bin:/usr/sbin:/usr/local/sbin:/usr/local/go/bin/
Environment=GO_ENV=production

[Install]
WantedBy=multi-user.target